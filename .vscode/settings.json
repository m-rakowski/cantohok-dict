{
  "json.schemas": [
    {
      "fileMatch": ["words/**/*.json"],
      "url": "./schema/word.schema.json"
    },
    {
      "fileMatch": ["cantonese/*.json"],
      "url": "./schema/page.schema.json"
    },
    {
      "fileMatch": ["pages-by-id.json"],
      "url": "./schema/pages-by-id.schema.json"
    },
    {
      "fileMatch": ["frequency.json"],
      "url": "./schema/frequency.schema.json"
    },
    {
      "fileMatch": ["aliases.json"],
      "url": "./schema/aliases.schema.json"
    }
  ]
}
