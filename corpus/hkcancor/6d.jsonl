{"english":[{"by":"machine","text":"Mr. Wong—Wong Sai-kit."}],"id":"0e8f4e7cb9497f03","jyutping":"aa3 jung1 saang1 aa3，jung1 sai3 git6 sin1 saang1 aa3。","jyutpingBy":"corpus","text":"阿翁生啊，翁世傑先生啊。","words":[{"jyutping":"aa3 jung1 saang1","pos":"nr","text":"阿翁生"},{"jyutping":"aa3","pos":"y","text":"啊"},{"jyutping":"jung1","pos":"nr","text":"翁"},{"jyutping":"sai3 git6","pos":"nr","text":"世傑"},{"jyutping":"sin1 saang1","pos":"n","text":"先生"},{"jyutping":"aa3","pos":"y","text":"啊"}]}
