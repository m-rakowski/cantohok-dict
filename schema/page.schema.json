{
  "$defs": {
    "example": {
      "additionalProperties": false,
      "properties": {
        "english": { "$ref": "#/$defs/nonEmptyString" },
        "traditional": { "$ref": "#/$defs/nonEmptyString" },
        "jyutping": { "$ref": "#/$defs/nonEmptyString" }
      },
      "required": ["english", "traditional", "jyutping"],
      "type": "object"
    },
    "box": {
      "additionalProperties": false,
      "properties": {
        "meaning": { "$ref": "#/$defs/nonEmptyString" },
        "english": {
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "minItems": 1,
          "type": "array"
        },
        "register": { "$ref": "#/$defs/nonEmptyString" },
        "note": { "$ref": "#/$defs/nonEmptyString" },
        "examples": {
          "items": { "$ref": "#/$defs/example" },
          "type": "array"
        }
      },
      "required": ["english", "meaning", "examples"],
      "type": "object"
    },
    "nonEmptyString": {
      "pattern": "\\S",
      "type": "string"
    }
  },
  "$id": "https://cantohok-dict/schema/page.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": { "pattern": "^[a-z0-9]{8}$", "type": "string" },
    "partOfSpeech": { "$ref": "#/$defs/nonEmptyString" },
    "traditional": { "$ref": "#/$defs/nonEmptyString" },
    "jyutping": { "$ref": "#/$defs/nonEmptyString" },
    "boxes": {
      "items": { "$ref": "#/$defs/box" },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": ["id", "traditional", "partOfSpeech", "jyutping", "boxes"],
  "type": "object"
}
