{
  "$defs": {
    "example": {
      "additionalProperties": false,
      "properties": {
        "id": { "pattern": "^[a-z0-9]{8}$", "type": "string" },
        "english": { "$ref": "#/$defs/nonEmptyString" },
        "traditional": { "$ref": "#/$defs/nonEmptyString" },
        "jyutping": { "$ref": "#/$defs/nonEmptyString" },
        "source": { "$ref": "#/$defs/sentenceSource" }
      },
      "required": ["id", "english", "traditional", "jyutping", "source"],
      "type": "object"
    },
    "englishEntry": {
      "additionalProperties": false,
      "properties": {
        "id": { "pattern": "^[a-z0-9]{8}$", "type": "string" },
        "word": { "pattern": "\\S", "type": ["string", "null"] },
        "meaning": { "$ref": "#/$defs/nonEmptyString" },
        "register": { "$ref": "#/$defs/nonEmptyString" },
        "note": { "$ref": "#/$defs/nonEmptyString" },
        "exampleSentences": {
          "items": { "$ref": "#/$defs/example" },
          "type": "array"
        }
      },
      "required": ["word", "meaning", "exampleSentences"],
      "type": "object"
    },
    "nonEmptyString": {
      "pattern": "\\S",
      "type": "string"
    },
    "sentenceSource": {
      "description": "Where the sentence came from: written for the dictionary (by), or copied from a line of corpus/ (corpus and line). englishBy names who wrote its English when that is not the sentence's writer, or for a copied sentence not the corpus's own English.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": { "by": { "$ref": "#/$defs/writer" }, "englishBy": { "$ref": "#/$defs/writer" } },
          "required": ["by"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "corpus": { "enum": ["tatoeba", "hkcancor", "hambaanglaang", "commonvoice"] },
            "englishBy": { "$ref": "#/$defs/writer" },
            "line": { "$ref": "#/$defs/nonEmptyString" }
          },
          "required": ["corpus", "line"],
          "type": "object"
        }
      ]
    },
    "writer": {
      "description": "Who wrote a sentence or its English: a model by its name, \"claude\" for a Claude model whose name was not recorded, \"contributor\" for a person: a reader who suggested it, or the dictionary's maintainer.",
      "enum": ["gpt-5.6-luna", "cantonesellm-v2.0-30b", "claude-opus-5.5", "claude", "contributor"]
    }
  },
  "$id": "https://cantohok-dict/schema/page.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": { "pattern": "^[a-z0-9]{8}$", "type": "string" },
    "partOfSpeech": {
      "enum": [
        "noun",
        "verb",
        "adj",
        "adv",
        "prep",
        "pron",
        "det",
        "conj",
        "num",
        "name",
        "intj",
        "phrase",
        "postp",
        null
      ]
    },
    "english": {
      "items": { "$ref": "#/$defs/englishEntry" },
      "minItems": 1,
      "type": "array"
    },
    "traditional": { "$ref": "#/$defs/nonEmptyString" },
    "jyutping": { "$ref": "#/$defs/nonEmptyString" },
    "cantonesePartOfSpeech": {
      "enum": [
        "noun",
        "verb",
        "adjective",
        "adverb",
        "pronoun",
        "conjunction",
        "preposition",
        "measure word",
        "particle",
        "sentence-final particle",
        "interjection",
        "sound word",
        "time word",
        "place word",
        "direction word",
        "numeral",
        "idiom",
        "fixed expression",
        "non-predicate adjective",
        "descriptive word",
        "prefix",
        "suffix",
        "abbreviation",
        "name"
      ]
    },
    "variants": {
      "items": { "pattern": "^\\S(?:.*\\S)?$", "type": "string" },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": ["id", "traditional", "partOfSpeech", "jyutping", "english"],
  "type": "object"
}
