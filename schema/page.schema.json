{
  "$defs": {
    "example": {
      "additionalProperties": false,
      "properties": {
        "id": { "pattern": "^[a-z0-9]{8}$", "type": "string" },
        "english": { "$ref": "#/$defs/nonEmptyString" },
        "traditional": { "$ref": "#/$defs/nonEmptyString" },
        "jyutping": { "$ref": "#/$defs/nonEmptyString" }
      },
      "required": ["id", "english", "traditional", "jyutping"],
      "type": "object"
    },
    "englishEntry": {
      "additionalProperties": false,
      "properties": {
        "id": { "pattern": "^[a-z0-9]{8}$", "type": "string" },
        "word": { "$ref": "#/$defs/nonEmptyString" },
        "meaning": { "$ref": "#/$defs/nonEmptyString" },
        "register": { "$ref": "#/$defs/nonEmptyString" },
        "note": { "$ref": "#/$defs/nonEmptyString" },
        "exampleSentences": {
          "items": { "$ref": "#/$defs/example" },
          "type": "array"
        }
      },
      "required": ["word", "meaning", "exampleSentences"],
      "type": "object"
    },
    "nonEmptyString": {
      "pattern": "\\S",
      "type": "string"
    }
  },
  "$id": "https://cantohok-dict/schema/page.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": { "pattern": "^[a-z0-9]{8}$", "type": "string" },
    "partOfSpeech": {
      "enum": ["noun", "verb", "adj", "adv", "prep", "pron", "det", "conj", "num", "name", "intj", "phrase", "postp"]
    },
    "english": {
      "items": { "$ref": "#/$defs/englishEntry" },
      "minItems": 1,
      "type": "array"
    },
    "traditional": { "$ref": "#/$defs/nonEmptyString" },
    "jyutping": { "$ref": "#/$defs/nonEmptyString" },
    "cantonesePartOfSpeech": {
      "enum": [
        "noun",
        "verb",
        "adjective",
        "adverb",
        "pronoun",
        "conjunction",
        "preposition",
        "measure word",
        "particle",
        "sentence-final particle",
        "interjection",
        "sound word",
        "time word",
        "place word",
        "direction word",
        "numeral",
        "idiom",
        "fixed expression",
        "non-predicate adjective",
        "descriptive word",
        "prefix",
        "suffix",
        "abbreviation",
        "name"
      ]
    },
    "variants": {
      "items": { "pattern": "^\\S(?:.*\\S)?$", "type": "string" },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": ["id", "traditional", "partOfSpeech", "jyutping", "english"],
  "type": "object"
}
