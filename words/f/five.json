    {
      "id": "p1q8i4j1",
      "partOfSpeech": "num",
      "meaning": "five of something",
      "traditional": "五 + CL + N",
      "jyutping": "ng5 CL N",
      "note": "Use this when counting five items, choosing the appropriate classifier for CL.",
      "example": {
        "english": "I bought five books.",
        "traditional": "我買咗五本書。",
